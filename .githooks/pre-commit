#!/usr/bin/env bash
# Installed via scripts/install-hooks.sh. Blocks any commit that would
# introduce a secret, per CLAUDE.md's "run gitleaks detect before every
# commit" rule - this hook is what actually enforces that, not the
# instruction alone.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed - install it (see https://github.com/gitleaks/gitleaks#installing) before committing" >&2
    exit 1
fi

gitleaks protect --staged --redact --verbose
